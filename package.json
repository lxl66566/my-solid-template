    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-unicorn": "^72.0.0",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "oxlint": "^1.75.0",
