    "typescript-eslint": "^8.65.0",
    "unocss": "^66.7.5",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "solid-js": "^1.9.14"
