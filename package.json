{
  "name": "my-solid-template",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "fmt": "prettier --write .",
    "lint": "oxlint . && eslint .",
    "check": "tsc --noEmit --strict --skipLibCheck",
    "knip": "knip",
    "verify": "pnpm fmt:check && pnpm lint && pnpm check && pnpm knip && pnpm test",
    "fmt:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint --fix",
      "eslint --fix"
    ],
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,css,html,md,yml,yaml}": "prettier --write"
  },
  "license": "MIT",
  "devDependencies": {
